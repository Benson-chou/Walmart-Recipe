# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Flyer admin scrape + Vercel Cron (use a long random string in production)
SCRAPE_SECRET=change-me
# Optional: Vercel Cron Authorization Bearer. Falls back to SCRAPE_SECRET.
CRON_SECRET=
# Optional: comma-separated ZIPs for scheduled flyer refresh (max 5)
CRON_ZIPS=90210

# Gemini (embeddings + generate/validate agents)
GEMINI_API_KEY=
# Optional: defaults to gemini-3.5-flash-lite
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
